menu "WiFi Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default "Your_Target_SSID"
        help
            The SSID (network name) of the target access point.

    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default "Your_Secure_Password"
        help
            The WPA2-PSK password for the target access point.

    config ESP_MQTT_BROKER_URI
        string "MQTT Broker URI"
        default "mqtt://broker.hivemq.com:1883"
endmenu